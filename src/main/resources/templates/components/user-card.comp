<!-- This is a custom XML template for our framework -->
<div class="user-card" xmlns:dt="http://www.w3.org/1999/xhtml">
    <dt:var name="appInfo">appName + " v" + version</dt:var>
    <dt:var name="headerText">"This is a header line"</dt:var>
    <!-- Use the new app-header component -->
    <dt:make-comp class="app-header" args="[headerText]"/>

    <!-- Use the new user-info component for displaying user details -->
    <dt:make-comp class="user-info"/>



    <dt:if cond="isAdmin">
        <dt:then>
            <p style="color: red; font-weight: bold;">ADMINISTRATOR ACCESS</p>
            <button>Delete User</button>
        </dt:then>
        <dt:else>
            <p style="color: green;">Standard User</p>
        </dt:else>
    </dt:if>

    <p>
        <span class="label">App Info:</span>
        <span><dt:v>appInfo</dt:v></span>
    </p>
</div>
