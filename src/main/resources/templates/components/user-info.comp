<div class="user-info-box" style="border: 2px solid #007bff; border-radius: 10px; padding: 20px; background-color: #fff; margin-bottom: 20px; position: relative;">
    <!-- Declare the user variable directly in the component -->
    <dt:var name="user">userService.getCurrentUserDTO()</dt:var>

    <div style="position: absolute; top: 10px; right: 10px; background: #28a745; color: white; padding: 2px 8px; border-radius: 4px; font-size: 10px;">LIVE UPDATES ON</div>

    <h2 style="color: #007bff; margin-top: 0;">User Profile</h2>

    <div style="display: grid; grid-template-columns: 100px 1fr; gap: 10px;">
        <span style="font-weight: bold;">Name:</span>
        <span style="display: flex; flex-direction: column; align-items: flex-start;">
            <input type="text" id="userNameInput" value="<dt:v>user.name</dt:v>" style="width: calc(100% - 10px); padding: 5px; border: 1px solid #ccc; border-radius: 3px;">
        </span>
         <span style="display: flex; flex-direction: column; align-items: flex-start;">
             <button id="updateNameButton" style="margin-top: 5px; padding: 5px 10px; background-color: #007bff; color: white; border: none; border-radius: 3px; cursor: pointer;">Update Name</button>
        </span>
        <span style="font-weight: bold;">Name:</span>
                <span><dt:v>user.name</dt:v></span>
        <span style="font-weight: bold;">Email:</span>
        <span><dt:v>user.email</dt:v></span>

        <span style="font-weight: bold;">Account:</span>
        <span><dt:v>user.acctype</dt:v></span>

        <span style="font-weight: bold;">Balance:</span>
        <span style="font-size: 1.2em; color: #28a745; font-weight: bold;">$<dt:v>user.balance.toFixed(2)</dt:v></span>
    </div>

    <hr style="border: 0; border-top: 1px solid #eee; margin: 15px 0;"/>

    <div style="font-size: 12px; color: #666;">
        Last Synced: <span><dt:v>getFormattedTime()</dt:v></span>
    </div>
</div>
